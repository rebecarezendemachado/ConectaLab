# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================================
# CONFIGURAÇÃO DE BANCO DE DADOS (MYSQL / MARIADB)
# =============================================================================
# Provedor ativo de dados da aplicação: 'local' (LocalStorage) ou 'api' (MySQL em tempo real)
VITE_DATABASE_PROVIDER="api"

# OPÇÃO 1: String de conexão completa com MySQL (Nuvem ou Local)
# Exemplo local: mysql://root:sua_senha@localhost:3306/materia_reativa_lab
# Exemplo nuvem: mysql://user:pass@host.provider.com:3306/materia_reativa_lab
DATABASE_URL="mysql://root:@localhost:3306/materia_reativa_lab"

# OPÇÃO 2: Parâmetros individuais (caso não utilize DATABASE_URL)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_DATABASE="materia_reativa_lab"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_SSL="false"
