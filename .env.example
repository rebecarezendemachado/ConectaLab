# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================================
# CONFIGURAÇÃO DE BANCO DE DADOS (MYSQL / MARIADB)
# =============================================================================
# Provedor ativo de dados da aplicação: 'local' (LocalStorage) ou 'api' (MySQL em tempo real)
VITE_DATABASE_PROVIDER="api"

# OPÇÃO 1: String de conexão completa com MySQL (Nuvem ou Local)
# Exemplo local: mysql://root:sua_senha@localhost:3306/materia_reativa_lab
# Exemplo nuvem: mysql://user:pass@host.provider.com:3306/materia_reativa_lab
DATABASE_URL="mysql://root:@localhost:3306/materia_reativa_lab"

# OPÇÃO 2: Parâmetros individuais (caso não utilize DATABASE_URL)
MYSQL_HOST="localhost"
MYSQL_PORT="3306"
MYSQL_DATABASE="materia_reativa_lab"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_SSL="false"

# =============================================================================
# SEGURANÇA E ADMINISTRADORA (professora Kátia)
# =============================================================================
# Em produção use NODE_ENV="production" (liga HTTPS estrito e a política de segurança do navegador).
NODE_ENV="development"

# Opcional: preencha os dois campos para criar a conta da administradora no primeiro start,
# ou redefinir a senha se ADMIN_EMAIL corresponder à conta administrativa já existente.
# Se deixar ADMIN_EMAIL vazio, a Kátia pode configurar o primeiro acesso pelo botão da tela inicial.
# A senha é guardada com hash. Se usar ADMIN_INITIAL_PASSWORD, escolha uma senha forte (mín. 10 caracteres)
# e remova a variável depois de confirmar o acesso.
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""
ADMIN_NOME="Kátia"

# APP_URL: endereço público do sistema (ex.: https://materia-reativa.onrender.com).
# Pode listar mais de um separado por vírgula. Usado na proteção contra requisições de outros sites.

# PRIMEIRO ACESSO E BANCO (JSON / MYSQL)
# =============================================================================
# O banco começa sem administradora. No modo local, o primeiro acesso guiado só funciona
# no próprio computador onde o servidor está instalado e pode ser usado uma vez.
# Em uma hospedagem pública, configure ADMIN_EMAIL e ADMIN_INITIAL_PASSWORD no servidor.
# Cadastros de alunos e professores ficam ativos imediatamente (sem aprovação manual).
#
# BANCO_JSON="true" (ou MODO_LOCAL="true"): usa banco em arquivo JSON persistente em ./dados-locais/materia-reativa.json
# (não precisa de MySQL). Em hospedagem, isso só mantém os dados se o disco for persistente.
# Sem MySQL configurado em desenvolvimento, o sistema já usa esse banco JSON automaticamente.
# Com MySQL configurado, preencha DATABASE_URL ou MYSQL_* acima.
# BANCO_JSON="true"